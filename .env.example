# Node.js >= 22.13 (recomendado Node.js 24).
# Clave privada de 16 caracteres o más; nunca usar NEXT_PUBLIC_ para esta clave.
ADMIN_PASSWORD=
# En producción debe apuntar a un volumen persistente del servidor.
ORDERS_DB_PATH=./data/orders.sqlite

# Dejar en false hasta validar todos los pendientes de P0.md.
NEXT_PUBLIC_COMMERCE_READY=false
# Dominio HTTPS real, sin barra final; dejar vacío mientras no exista.
NEXT_PUBLIC_SITE_URL=

# P3: medición propia opcional, sin servicios externos. Activar y reconstruir.
NEXT_PUBLIC_METRICS_ENABLED=false
# Base independiente de ORDERS_DB_PATH, en un disco persistente.
METRICS_DB_PATH=./data/activity.sqlite
